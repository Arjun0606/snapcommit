{
  "name": "@snapcommit/mcp",
  "version": "0.1.0",
  "description": "Memory layer for AI tools. One MCP server, works across Claude Code, Cursor, VS Code, Cline, Windsurf, Claude Desktop + 25 more. Local-first.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "snapcommit-mcp": "dist/index.js",
    "snapcommit-install": "dist/install.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "memory",
    "ai",
    "claude",
    "cursor",
    "llm"
  ],
  "author": "Arjun Varma",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Arjun0606/snapcommit"
  },
  "homepage": "https://snapcommit.com",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "better-sqlite3": "^11.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
